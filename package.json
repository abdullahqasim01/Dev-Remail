{
  "name": "dev-remail",
  "version": "0.1.0",
  "private": true,
  "description": "A local, Resend-compatible mail sandbox with a mailbox UI and signed webhooks.",
  "license": "MIT",
  "author": "Abdullah Qasim",
  "scripts": {
    "dev": "prisma generate && node scripts/migrate.mjs && next dev -p 6245",
    "build": "prisma generate && next build",
    "start": "next start -p 6245",
    "lint": "eslint",
    "db:migrate": "node scripts/migrate.mjs",
    "docker:build": "docker build -t dev-remail .",
    "docker:publish": "docker buildx build --platform linux/amd64,linux/arm64 -t $DOCKER_USER/dev-remail:latest --push .",
    "test": "node --test \"tests/*.test.mjs\"",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^12.11.1",
    "next": "16.4.5",
    "prisma": "^7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "resend": "^6.37.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}
